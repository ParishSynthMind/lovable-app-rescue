# Browser-safe values only. Local: `supabase status -o env` prints both.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# The Claude key is NOT set here. It is an Edge Function secret:
#   supabase secrets set ANTHROPIC_API_KEY=...        (hosted)
#   supabase functions serve --env-file <file>         (local)
